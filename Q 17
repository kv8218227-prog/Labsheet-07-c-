#include <iostream>
#include <cstring>
using namespace std;

int main() {
    char str[100], result[100];
    int j = 0;
    cin.getline(str, 100);

    for(int i = 0; i < strlen(str); i++) {
        char c = str[i];

        if(c!='a'&&c!='e'&&c!='i'&&c!='o'&&c!='u'&&
           c!='A'&&c!='E'&&c!='I'&&c!='O'&&c!='U')
            result[j++] = c;
    }

    result[j] = '\0';
    cout << result;
    return 0;
}
