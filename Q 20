#include <iostream>
#include <cstring>
using namespace std;

int main() {
    char a[100], b[100];
    int count[256] = {0};

    cin >> a >> b;

    if(strlen(a) != strlen(b)) {
        cout << "Not Anagrams";
        return 0;
    }

    for(int i = 0; a[i] != '\0'; i++) {
        count[(unsigned char)a[i]]++;
        count[(unsigned char)b[i]]--;
    }

    for(int i = 0; i < 256; i++)
        if(count[i] != 0) {
            cout << "Not Anagrams";
            return 0;
        }

    cout << "Anagrams";
    return 0;
}
