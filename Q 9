#include <iostream>
#include <cstring>
using namespace std;

int main() {
    char s[5][50], temp[50];

    for(int i = 0; i < 5; i++)
        cin >> s[i];

    for(int i = 0; i < 4; i++)
        for(int j = i + 1; j < 5; j++)
            if(strcmp(s[i], s[j]) > 0) {
                strcpy(temp, s[i]);
                strcpy(s[i], s[j]);
                strcpy(s[j], temp);
            }

    for(int i = 0; i < 5; i++)
        cout << s[i] << endl;

    return 0;
}
